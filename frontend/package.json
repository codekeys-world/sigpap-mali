{
  "name": "apes-rh-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --config .prettierrc.json --write \"src/**/*.{ts,html,css,scss}\" \"tests/**/*.cjs\" \"*.{json,cjs}\" \"../backend/src/{main,test}/java/**/*.java\" \"../backend/pom.xml\" \"../backend/src/main/resources/*.yml\" \"../docker-compose.yml\" \"../README.md\"",
    "format:check": "prettier --config .prettierrc.json --check \"src/**/*.{ts,html,css,scss}\" \"tests/**/*.cjs\" \"*.{json,cjs}\" \"../backend/src/{main,test}/java/**/*.java\" \"../backend/pom.xml\" \"../backend/src/main/resources/*.yml\" \"../docker-compose.yml\" \"../README.md\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.4",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.14.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@prettier/plugin-xml": "^3.4.2",
    "prettier": "^3.10.1",
    "prettier-plugin-java": "^2.11.0",
    "typescript": "~5.5.4"
  }
}
